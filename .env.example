# CapFree API credentials.
#
# Copy to .env and fill in what you need. Everything is optional: a key that
# is not set only turns its own feature off, and the UI says so rather than
# failing somewhere less obvious.
#
# .env is gitignored. Never commit real values, and never paste them into
# source files.

# --- Existing features -----------------------------------------------------
# OPENAI_API_KEY=
# PIXABAY_API_KEY=
# FREESOUND_API_KEY=
# FREESOUND_CLIENT_ID=

# --- Share to social -------------------------------------------------------
# YouTube, via a Google Cloud project with the YouTube Data API v3 enabled.
# Add http://localhost:8000/oauth/youtube/callback as an authorised redirect
# URI on the OAuth client.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# TikTok, via a TikTok for Developers app with the Content Posting API added.
# Redirect URI: http://localhost:8000/oauth/tiktok/callback
# Until the app passes TikTok's audit it can only create private posts.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# Instagram Reels, via a Meta app using the Instagram Graph API — which needs
# an Instagram Business or Creator account linked to a Facebook Page. (The
# Basic Display API cannot publish and was shut down in December 2024.)
# Redirect URI: http://localhost:8000/oauth/instagram/callback
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# Instagram fetches the video from a URL rather than accepting an upload, so
# publishing a Reel needs the export folder reachable from the internet. Set
# this to the base URL it is served from; without it, Instagram uploads are
# refused with an explanation instead of failing silently.
# PUBLIC_MEDIA_BASE_URL=

# Where the OAuth callbacks come back to. Only change this if the API is not
# on localhost:8000; it must match the redirect URIs registered above.
# CAPFREE_API_BASE=http://localhost:8000
